{"flows":[
 {"name":"book-a-groom","ready":"#view h1","steps":[
   {"goto":"/index.html#/time"},{"waitFor":".slot"},{"screenshot":"book-time"},
   {"click":"role=radio[name=/Thursday.*19/]"},{"waitFor":".slot"},
   {"click":"role=radio[name=/^9:30.*drop-off/]"},{"waitFor":300},{"screenshot":"book-time-selected"},
   {"click":"#continue"},{"waitFor":"#book"},{"screenshot":"book-review"},
   {"click":"#book"},{"waitFor":".booked"},{"waitFor":600},{"screenshot":"booked"},
   {"click":"role=button[name=\"Done\"]"},{"waitFor":".home"},{"screenshot":"home"}],
  "states":[
   {"name":"loading","goto":"/index.html?state=loading#/time","waitFor":".skeleton","screenshot":"book-time"},
   {"name":"error","goto":"/index.html?state=error#/time","waitFor":"text=Try again","screenshot":"book-time"},
   {"name":"partial","goto":"/index.html?state=partial#/time","waitFor":".notice","screenshot":"book-time"},
   {"name":"full","goto":"/index.html?state=full#/time","waitFor":"text=fully booked","screenshot":"book-time"},
   {"name":"closed","goto":"/index.html?state=closed#/time","waitFor":"text=closed on","screenshot":"book-time"},
   {"name":"groomer-empty","goto":"/index.html?state=groomer-empty#/time","waitFor":"text=Show Sam","screenshot":"book-time"},
   {"name":"conflict","goto":"/index.html?state=conflict#/time","waitFor":".notice-error","screenshot":"book-time"}
  ]},
 {"name":"earlier-steps","ready":"#view h1","steps":[
   {"goto":"/index.html#/dog"},{"screenshot":"book-dog"},
   {"click":"role=radio[name=/Bella/]"},{"waitFor":"text=What does Bella need?"},{"screenshot":"book-service"},
   {"click":"role=radio[name=/Full groom/]"},{"waitFor":"text=Who should groom Bella?"},{"screenshot":"book-groomer"}]}
]}
