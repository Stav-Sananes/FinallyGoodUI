      "$value": "999px"
    }
  },
  "icon": {
    "sm": {
      "$type": "dimension",
      "$value": "20px"
    },
    "md": {
      "$type": "dimension",
      "$value": "24px"
    },
    "stroke": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "50ms"
    },
    "micro": {
      "$type": "duration",
      "$value": "100ms"
    },
    "short": {
      "$type": "duration",
      "$value": "150ms"
    },
    "standard": {
      "$type": "duration",
      "$value": "250ms"
    },
    "medium": {
      "$type": "duration",
      "$value": "300ms"
    },
    "long": {
      "$type": "duration",
      "$value": "400ms"
    },
    "hero": {
      "$type": "duration",
      "$value": "500ms"
    }
  },
  "easing": {
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "enter-emphasized": {
      "$type": "cubicBezier",
      "$value": [
        0.05,
        0.7,
        0.1,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    },
    "move": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "snappy": {
      "$type": "cubicBezier",
      "$value": [
        0.23,
        1,
        0.32,
        1
      ]
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ]
    }
  }
}