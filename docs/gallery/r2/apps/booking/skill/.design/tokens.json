  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Bricolage Grotesque",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "400 700"
          }
        }
      }
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Figtree",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "400 700"
          }
        }
      }
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.4,
          "letterSpacing": "0.07em"
        }
      },
      "$description": "Caps labels only"
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.45,
          "letterSpacing": "0em"
        }
      }
    },
    "base": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.5,
          "letterSpacing": "0em"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.4,
          "letterSpacing": "0em"
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "22px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.25,
          "letterSpacing": "-0.015em"
        }
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": "28px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.15,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "display": {
      "$type": "dimension",
      "$value": "60px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1,
          "letterSpacing": "-0.035em"
        }
      },
      "$description": "The stage readout"
    }
  },
  "tracking": {
    "caps": {
      "$type": "number",
      "$value": 0.07
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
