  "font": {
    "serif": {
      "$type": "fontFamily",
      "$value": ["Newsreader", "ui-serif", "Georgia", "serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "200 800"
          }
        }
      }
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Hanken Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "100 900"
          }
        }
      }
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.35,
          "letterSpacing": "0.06em"
        }
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.4,
          "letterSpacing": "0em"
        }
      }
    },
    "base": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.5,
          "letterSpacing": "0em"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
