  "easing": {
    "enter": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0, 1]
    },
    "enter-emphasized": {
      "$type": "cubicBezier",
      "$value": [0.05, 0.7, 0.1, 1]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [0.3, 0, 1, 1]
    },
    "move": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "snappy": {
      "$type": "cubicBezier",
      "$value": [0.23, 1, 0.32, 1]
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1]
    }
