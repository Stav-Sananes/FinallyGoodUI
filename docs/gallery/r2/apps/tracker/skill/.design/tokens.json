  "icon": {
    "sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "md": {
      "$type": "dimension",
      "$value": "18px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "stroke": {
      "$type": "number",
      "$value": 1.5
    }
