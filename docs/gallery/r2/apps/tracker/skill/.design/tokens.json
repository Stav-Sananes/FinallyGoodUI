  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Source Sans 3", "ui-sans-serif", "system-ui", "sans-serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "400 700"
          }
        }
      }
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["Newsreader", "ui-serif", "Georgia", "serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": [500, 600]
          }
        }
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": [500]
          }
        }
      }
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.35,
