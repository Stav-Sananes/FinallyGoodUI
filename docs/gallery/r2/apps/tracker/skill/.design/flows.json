      "#f-title",
      "Billing page shows the old VAT rate for Austria"
     ]
    },
    {
     "click": "#f-submit"
    },
    {
     "waitFor": "text=filed in Triage"
    },
    {
     "screenshot": "issue-filed"
    }
   ]
  },
  {
   "name": "delete-issue",
   "steps": [
    {
     "goto": "/index.html?view=all"
