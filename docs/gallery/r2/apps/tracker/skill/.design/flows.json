{
 "flows": [
  {
   "name": "morning-triage",
   "steps": [
    {
     "goto": "/index.html?view=triage"
    },
    {
     "waitFor": "#row-ENG-214"
    },
    {
     "screenshot": "triage"
    },
    {
     "click": "#row-ENG-214"
    },
    {
     "press": "y"
    },
    {
     "press": "y"
    },
    {
     "press": "b"
    },
    {
     "press": "n"
    },
    {
     "press": "y"
    },
    {
     "press": "n"
    },
    {
     "waitFor": "text=Triage clear"
    },
    {
     "screenshot": "triage-clear"
    }
   ],
   "states": [
    {
     "name": "empty",
     "goto": "/index.html?view=triage&state=empty",
     "waitFor": "text=Nothing to triage",
     "screenshot": "triage-empty"
    }
   ]
  },
  {
   "name": "filter-list",
   "steps": [
    {
     "goto": "/index.html?view=all"
    },
    {
     "waitFor": "#row-ENG-201"
    },
    {
     "screenshot": "all-issues"
    },
    {
     "click": "[data-filter=\"priority\"]"
    },
    {
     "click": "#menu-list .opt >> text=Urgent"
    },
    {
     "press": "Escape"
    },
    {
     "waitFor": "text=Clear filters"
    },
    {
     "screenshot": "all-filtered"
    }
   ],
   "states": [
    {
     "name": "empty",
     "goto": "/index.html?view=all&state=empty",
     "waitFor": "text=No issues yet",
     "screenshot": "all-empty"
    },
    {
     "name": "no-results",
     "goto": "/index.html?view=all&priority=1&assignee=hana",
     "waitFor": "text=No issues match these filters",
     "screenshot": "all-no-results"
    },
    {
     "name": "loading",
     "goto": "/index.html?view=all&state=loading",
     "screenshot": "all-loading"
    },
    {
     "name": "error",
     "goto": "/index.html?view=all&state=error",
     "waitFor": "text=Try again",
     "screenshot": "all-error"
    },
    {
     "name": "partial",
     "goto": "/index.html?view=all&state=offline",
     "waitFor": "text=Reconnect",
     "screenshot": "all-offline"
    },
    {
     "name": "denied",
     "goto": "/index.html?view=all&issue=ENG-097",
     "waitFor": "text=You can’t open ENG-097",
     "screenshot": "issue-denied"
    }
   ]
  },
  {
   "name": "change-issue",
   "steps": [
    {
     "goto": "/index.html?view=all"
    },
    {
     "waitFor": "#row-ENG-205"
    },
    {
     "click": "#row-ENG-205"
    },
    {
     "screenshot": "issue-panel"
    },
    {
     "press": "s"
    },
    {
     "waitFor": "#menu-list .opt"
    },
    {
     "screenshot": "status-menu"
    },
    {
     "press": "4"
    },
    {
     "waitFor": "text=ENG-205 moved to In review"
    },
    {
     "screenshot": "status-changed"
    }
   ],
   "states": [
    {
     "name": "save-fails",
     "steps": [
      {
       "goto": "/index.html?view=all&state=savefail"
      },
      {
       "waitFor": "#row-ENG-205"
      },
      {
       "click": "#row-ENG-205"
      },
      {
       "press": "s"
      },
      {
       "press": "4"
      },
      {
       "waitFor": "text=Couldn’t save"
      }
     ],
     "screenshot": "save-failed"
    }
   ]
  },
  {
