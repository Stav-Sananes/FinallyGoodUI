  "icon": {
    "$description": "Icon box sizes, about 1.15-1.25x the text beside them (sm with text.sm, md with text.base, lg standalone); stroke in the icon set own 24-unit grid",
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "stroke": {
      "$type": "number",
      "$value": 1.75
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": {
        "value": 50,
        "unit": "ms"
      },
      "$description": "Press feedback"
    },
    "micro": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
