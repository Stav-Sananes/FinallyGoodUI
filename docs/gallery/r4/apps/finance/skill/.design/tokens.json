  "icon": {
    "$description": "Icon box sizes, about 1.15-1.25x the text beside them (sm with text.sm, md with text.base, lg standalone); stroke in the icon set own 24-unit grid",
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "stroke": 1.75
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": {
        "value": 50,
        "unit": "ms"
      },
      "$description": "Press feedback"
    },
    "micro": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
      },
      "$description": "Hover, toggles"
    },
    "short": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      },
      "$description": "Small reveals, exits of standard"
    },
    "standard": {
      "$type": "duration",
      "$value": {
        "value": 250,
        "unit": "ms"
      },
      "$description": "Popovers, menus"
    },
    "medium": {
      "$type": "duration",
      "$value": {
        "value": 300,
        "unit": "ms"
      },
      "$description": "Sheets, drawers"
    },
    "long": {
      "$type": "duration",
      "$value": {
        "value": 400,
        "unit": "ms"
      },
      "$description": "Page transitions; ceiling for routine UI"
    },
    "hero": {
      "$type": "duration",
      "$value": {
        "value": 600,
        "unit": "ms"
      },
      "$description": "Expressive moments only (up to three per app); nothing longer except backdrops"
    }
  },
  "easing": {
    "enter": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0, 1],
      "$description": "Elements arriving (decelerate)"
    },
    "enter-emphasized": {
      "$type": "cubicBezier",
      "$value": [0.05, 0.7, 0.1, 1],
      "$description": "Expressive arrivals, signature moment"
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [0.3, 0, 1, 1],
      "$description": "Elements leaving (accelerate)"
    },
    "move": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1],
      "$description": "On-screen movement and resizing"
    },
    "snappy": {
      "$type": "cubicBezier",
      "$value": [0.23, 1, 0.32, 1],
      "$description": "Direct-manipulation feedback, drawers"
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1],
      "$description": "Progress, opacity-only loops"
    }
  },
