  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "sans-serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "fontsource"
          }
        }
      }
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Hanken Grotesk", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "fontsource"
          }
        }
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$extensions": {
        "fgu": {
          "lineHeight": 1.5,
          "letterSpacing": {
            "value": 0,
            "unit": "em"
          }
        }
      },
      "$description": "Captions, badges; never body"
    },
    "sm": {
      "$type": "dimension",
