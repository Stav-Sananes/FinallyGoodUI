{
 "flows": [
  {
   "name": "plan-week",
   "ready": "#week-region[data-state=\"ready\"], #week-region[data-state=\"loading\"], #week-region[data-state=\"error\"]",
   "steps": [
    {
     "goto": "/index.html"
    },
    {
     "screenshot": "week"
    },
    {
     "click": "text=Plan Wednesday"
    },
    {
     "waitFor": "#picker[open]"
    },
    {
     "screenshot": "pick"
    },
    {
     "click": "role=button[name*=\"Red lentil dal\"]"
    },
    {
     "waitFor": "text=Wednesday: Red lentil dal"
    },
    {
     "click": "text=Plan Sunday"
    },
    {
     "waitFor": "#picker[open]"
    },
    {
     "click": "role=button[name*=\"Miso salmon\"]"
    },
    {
     "waitFor": "text=Week planned"
    },
    {
     "waitFor": 700
    },
    {
     "screenshot": "week-planned"
    }
   ],
   "states": [
    {
     "name": "empty",
     "goto": "/index.html?state=empty",
     "screenshot": "week-empty"
    },
    {
     "name": "loading",
     "goto": "/index.html?state=loading",
     "screenshot": "week-loading",
     "waitFor": "#week-region[data-state=\"loading\"]"
    },
    {
     "name": "error",
     "goto": "/index.html?state=error",
     "screenshot": "week-error",
     "waitFor": "text=Try again"
    },
    {
     "name": "offline",
     "goto": "/index.html?state=offline",
     "screenshot": "week-offline",
     "waitFor": "text=You’re offline."
    },
    {
     "name": "picker-error",
     "steps": [
      {
       "goto": "/index.html?state=picker-error"
      },
      {
       "click": "text=Plan Wednesday"
      },
      {
       "waitFor": "text=Recipes didn’t load"
      }
     ],
     "screenshot": "pick-error"
    }
   ]
  },
  {
   "name": "cook-tonight",
   "steps": [
    {
     "goto": "/index.html"
    },
    {
     "click": "role=button[name=\"Start cooking\"]"
    },
    {
     "waitFor": "#recipe-panel:not([hidden])"
    },
    {
     "waitFor": 500
    },
    {
     "screenshot": "recipe"
    }
   ],
   "states": [
    {
     "name": "recipe-error",
     "goto": "/index.html?state=recipe-error#recipe/lemon-chicken/0",
     "waitFor": "text=This recipe didn’t open",
     "screenshot": "recipe-error"
    },
    {
     "name": "recipe-loading",
     "goto": "/index.html?state=recipe-loading#recipe/lemon-chicken/0",
     "waitFor": "#recipe-panel:not([hidden])",
     "screenshot": "recipe-loading"
    }
   ]
  },
  {
   "name": "shop-by-aisle",
   "steps": [
    {
     "goto": "/index.html#list"
    },
    {
     "waitFor": "text=Fruit & veg"
    },
    {
     "screenshot": "list"
    },
    {
     "click": "text=Black beans"
    },
    {
     "waitFor": 500
    },
    {
     "screenshot": "list-ticked"
    }
   ],
   "states": [
    {
     "name": "empty",
     "goto": "/index.html?state=empty#list",
     "waitFor": "text=Your list fills as you plan dinners",
     "screenshot": "list-empty"
    }
   ]
  },
  {
   "name": "recipes",
   "steps": [
    {
     "goto": "/index.html#recipes"
    },
    {
     "waitFor": "text=Shakshuka with crusty bread"
    },
    {
     "screenshot": "recipes"
    }
   ],
   "states": [
    {
     "name": "no-recipes",
     "goto": "/index.html?state=no-recipes#recipes",
     "waitFor": "text=No recipes saved yet",
     "screenshot": "recipes-empty"
    }
   ]
  },
  {
   "name": "clear-night",
   "steps": [
    {
     "goto": "/index.html"
    },
    {
     "click": "role=button[name=\"Swap Thursday’s dinner\"]"
    },
    {
     "waitFor": "#picker[open]"
    },
    {
     "click": "text=Clear Thursday"
    },
    {
     "waitFor": "text=Thursday cleared."
    },
    {
     "waitFor": 400
    },
    {
     "screenshot": "week-cleared"
    }
   ]
  }
 ]
}