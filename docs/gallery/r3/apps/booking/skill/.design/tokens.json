      "$type": "fontFamily",
      "$value": ["Archivo", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"],
      "$description": "Stamped dog-tag grotesk; width axis 100/125 gives the display voice",
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "400 800",
            "axes": {
              "wdth": "100 125"
            }
          }
        }
      }
    }
  },
  "text": {
