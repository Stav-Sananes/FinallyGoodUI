{
  "$description": "Studio Ledger — Direction C: Day Book. Ledger-green paper, green-ink primary, red ink for what is late.",
  "color": {
    "background": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.952, 0.024, 150],
        "hex": "#e4f4e7"
      },
      "$description": "Ledger paper canvas"
    },
    "foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.25, 0.03, 165],
        "hex": "#13261e"
      },
      "$description": "Green-black ink"
    },
    "card": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.982, 0.012, 150],
        "hex": "#f4fcf5"
      },
      "$description": "Sheet: raised section surface"
    },
    "card-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.25, 0.03, 165],
        "hex": "#13261e"
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.4, 0.085, 163],
        "hex": "#03563a"
      },
      "$description": "Green ink: actions, runway rule, current tab"
    },
    "primary-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.012, 150],
        "hex": "#f5fdf6"
      }
    },
    "muted": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.925, 0.026, 152],
        "hex": "#daecde"
      },
      "$description": "Quiet fills: skeletons, bar tracks"
    },
    "muted-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.46, 0.03, 165],
        "hex": "#495e54"
      },
      "$description": "Secondary ink"
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.93, 0.03, 155],
        "hex": "#d9eedf"
      },
      "$description": "Hover row tint"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.25, 0.03, 165],
        "hex": "#13261e"
      }
    },
    "destructive": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.52, 0.19, 27],
        "hex": "#be2323"
      },
      "$description": "Red ink: 30+ days late, failures, run-out mark"
    },
    "destructive-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.01, 27],
        "hex": "#fff8f6"
      }
    },
    "success": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.43, 0.1, 150],
        "hex": "#1c5f31"
      },
      "$description": "Covered / paid; with icon + text"
    },
    "success-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.01, 150],
        "hex": "#f6fcf7"
      }
    },
    "warning": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.5, 0.12, 65],
        "hex": "#915200"
      },
      "$description": "Overdue under 30 days; with icon + text"
    },
    "warning-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.01, 65],
        "hex": "#fff9f3"
      }
    },
    "info": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.47, 0.09, 235],
        "hex": "#186286"
      },
      "$description": "Due soon; with icon + text"
    },
    "info-foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.01, 235],
        "hex": "#f4fbff"
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.4, 0.06, 160],
        "alpha": 0.22,
        "hex": "#28523c"
      },
      "$description": "Ledger rule (hairline)"
    },
    "input": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.55, 0.04, 162],
        "hex": "#5d796a"
      },
      "$description": "Control borders, >= 3:1"
    },
    "overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.25, 0.03, 165],
        "alpha": 0.4,
        "hex": "#13261e"
      },
      "$description": "Scrim"
    },
    "ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.4, 0.085, 163],
        "hex": "#03563a"
      },
      "$description": "Focus ring"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Archivo", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": "400 700",
            "axes": "wdth 62..125"
          }
        }
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
      "$extensions": {
        "fgu": {
          "load": {
            "source": "google",
            "weights": [400, 500]
          }
        }
      }
    }
  },
  "text": {
    "xs": {
      "$type": "dimension",
      "$value": "12px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.4
        }
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "14px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.45
        }
      }
    },
    "base": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.5
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.4
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.35
        }
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": "24px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.25
        }
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": "30px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.2
        }
      }
    },
    "4xl": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1.1
        }
      }
    },
    "5xl": {
      "$type": "dimension",
      "$value": "56px",
      "$extensions": {
        "fgu": {
          "lineHeight": 1
        }
      }
    },
    "6xl": {
      "$type": "dimension",
      "$value": "88px",
      "$extensions": {
        "fgu": {
          "lineHeight": 0.95
        }
      }
    }
  },
  "tracking": {
    "caps": {
      "$type": "number",
      "$value": 0.08
    },
    "display": {
      "$type": "number",
      "$value": -0.03
    },
    "heading": {
      "$type": "number",
      "$value": -0.01
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "20": {
      "$type": "dimension",
      "$value": "80px"
    },
    "24": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "10px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": {
          "colorSpace": "oklch",
          "components": [0.25, 0.03, 165],
          "alpha": 0.06,
          "hex": "#13261e"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.25, 0.03, 165],
            "alpha": 0.08,
            "hex": "#13261e"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "oklch",
            "components": [0.25, 0.03, 165],
            "alpha": 0.12,
            "hex": "#13261e"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": -8,
            "unit": "px"
          }
        }
      ]
    }
  },
  "icon": {
    "sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "stroke": {
      "$type": "number",
      "$value": 1.5
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "50ms"
    },
    "micro": {
      "$type": "duration",
      "$value": "100ms"
    },
    "short": {
      "$type": "duration",
      "$value": "150ms"
    },
    "standard": {
      "$type": "duration",
      "$value": "250ms"
    },
    "medium": {
      "$type": "duration",
      "$value": "300ms"
    },
    "long": {
      "$type": "duration",
      "$value": "400ms"
    },
    "hero": {
      "$type": "duration",
      "$value": "600ms"
    }
  },
  "easing": {
    "enter": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0, 1]
    },
    "enter-emphasized": {
      "$type": "cubicBezier",
      "$value": [0.05, 0.7, 0.1, 1]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [0.3, 0, 1, 1]
    },
    "move": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "snappy": {
      "$type": "cubicBezier",
      "$value": [0.23, 1, 0.32, 1]
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [0, 0, 1, 1]
    }
  }
}
