{
  "$description": "finally-good-ui neutral defaults (DTCG subset). Cool neutrals with a slight hue, one restrained accent, designed dark values in $extensions.fgu.dark. Adjust from the brief; do not ship unexamined.",
  "color": {
    "background": { "$type": "color", "$value": "oklch(0.99 0.002 265)", "$extensions": { "fgu": { "dark": "oklch(0.17 0.008 265)" } }, "$description": "App canvas" },
    "foreground": { "$type": "color", "$value": "oklch(0.21 0.012 265)", "$extensions": { "fgu": { "dark": "oklch(0.95 0.004 265)" } }, "$description": "Body text on background" },
    "card": { "$type": "color", "$value": "oklch(1 0 0)", "$extensions": { "fgu": { "dark": "oklch(0.205 0.009 265)" } }, "$description": "Raised surface; lighter than canvas in dark mode" },
    "card-foreground": { "$type": "color", "$value": "oklch(0.21 0.012 265)", "$extensions": { "fgu": { "dark": "oklch(0.95 0.004 265)" } } },
    "primary": { "$type": "color", "$value": "oklch(0.5 0.14 262)", "$extensions": { "fgu": { "dark": "oklch(0.72 0.12 262)" } }, "$description": "The one accent: primary actions, selection, links" },
    "primary-foreground": { "$type": "color", "$value": "oklch(0.985 0.003 265)", "$extensions": { "fgu": { "dark": "oklch(0.18 0.02 262)" } } },
    "muted": { "$type": "color", "$value": "oklch(0.96 0.005 265)", "$extensions": { "fgu": { "dark": "oklch(0.24 0.009 265)" } }, "$description": "Quiet fills: table stripes, disabled, code" },
    "muted-foreground": { "$type": "color", "$value": "oklch(0.5 0.012 265)", "$extensions": { "fgu": { "dark": "oklch(0.72 0.01 265)" } }, "$description": "Secondary text; passes 4.5:1 on background and muted" },
    "accent": { "$type": "color", "$value": "oklch(0.95 0.012 262)", "$extensions": { "fgu": { "dark": "oklch(0.27 0.02 262)" } }, "$description": "Hover/selected row tint (shadcn sense, not a second brand colour)" },
    "accent-foreground": { "$type": "color", "$value": "oklch(0.25 0.03 262)", "$extensions": { "fgu": { "dark": "oklch(0.95 0.01 262)" } } },
    "destructive": { "$type": "color", "$value": "oklch(0.53 0.19 27)", "$extensions": { "fgu": { "dark": "oklch(0.7 0.16 25)" } }, "$description": "Irreversible or failed actions" },
    "destructive-foreground": { "$type": "color", "$value": "oklch(0.985 0.003 27)", "$extensions": { "fgu": { "dark": "oklch(0.17 0.02 25)" } } },
    "success": { "$type": "color", "$value": "oklch(0.5 0.11 150)", "$extensions": { "fgu": { "dark": "oklch(0.74 0.13 150)" } }, "$description": "Status only; always paired with icon or text" },
    "success-foreground": { "$type": "color", "$value": "oklch(0.985 0.003 150)", "$extensions": { "fgu": { "dark": "oklch(0.18 0.03 150)" } } },
    "warning": { "$type": "color", "$value": "oklch(0.82 0.14 80)", "$extensions": { "fgu": { "dark": "oklch(0.8 0.13 80)" } }, "$description": "Status only; dark text on it in both themes" },
    "warning-foreground": { "$type": "color", "$value": "oklch(0.25 0.04 60)", "$extensions": { "fgu": { "dark": "oklch(0.22 0.04 60)" } } },
    "border": { "$type": "color", "$value": "oklch(0.91 0.004 265)", "$extensions": { "fgu": { "dark": "oklch(0.29 0.01 265)" } }, "$description": "Dividers and card edges (decorative, not a control boundary)" },
    "input": { "$type": "color", "$value": "oklch(0.62 0.01 265)", "$extensions": { "fgu": { "dark": "oklch(0.52 0.012 265)" } }, "$description": "Form control borders; >= 3:1 against background (WCAG 1.4.11)" },
    "ring": { "$type": "color", "$value": "oklch(0.55 0.14 262)", "$extensions": { "fgu": { "dark": "oklch(0.72 0.12 262)" } }, "$description": "Focus ring; >= 3:1 against background" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"] }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.5, "letterSpacing": { "value": 0, "unit": "em" } } }, "$description": "Captions, badges; never body" },
    "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.5, "letterSpacing": { "value": 0, "unit": "em" } } } },
    "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.5, "letterSpacing": { "value": 0, "unit": "em" } } }, "$description": "Body; also the minimum for inputs (prevents iOS zoom)" },
    "lg": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.5, "letterSpacing": { "value": 0, "unit": "em" } } } },
    "xl": { "$type": "dimension", "$value": { "value": 20, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.4, "letterSpacing": { "value": 0, "unit": "em" } } } },
    "2xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.3, "letterSpacing": { "value": -0.01, "unit": "em" } } } },
    "3xl": { "$type": "dimension", "$value": { "value": 30, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.25, "letterSpacing": { "value": -0.015, "unit": "em" } } } },
    "4xl": { "$type": "dimension", "$value": { "value": 36, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.2, "letterSpacing": { "value": -0.02, "unit": "em" } } } },
    "5xl": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.1, "letterSpacing": { "value": -0.025, "unit": "em" } } } },
    "6xl": { "$type": "dimension", "$value": { "value": 60, "unit": "px" }, "$extensions": { "fgu": { "lineHeight": 1.05, "letterSpacing": { "value": -0.03, "unit": "em" } } } }
  },
  "tracking": {
    "caps": { "$type": "dimension", "$value": { "value": 0.06, "unit": "em" }, "$description": "Uppercase labels at 10-13px open up (craft.tracking-by-size); never letterspace lowercase text" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "10": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "20": { "$type": "dimension", "$value": { "value": 80, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } },
    "32": { "$type": "dimension", "$value": { "value": 128, "unit": "px" } }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Default for controls and cards" },
    "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "xl": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px 0 oklch(0.21 0.012 265 / 0.06)", "$extensions": { "fgu": { "dark": "0 1px 2px 0 oklch(0 0 0 / 0.4)" } } },
    "md": { "$type": "shadow", "$value": "0 2px 4px -1px oklch(0.21 0.012 265 / 0.06), 0 4px 12px -2px oklch(0.21 0.012 265 / 0.08)", "$extensions": { "fgu": { "dark": "0 2px 4px -1px oklch(0 0 0 / 0.4), 0 4px 12px -2px oklch(0 0 0 / 0.5)" } } },
    "lg": { "$type": "shadow", "$value": "0 8px 16px -4px oklch(0.21 0.012 265 / 0.08), 0 16px 40px -8px oklch(0.21 0.012 265 / 0.12)", "$extensions": { "fgu": { "dark": "0 8px 16px -4px oklch(0 0 0 / 0.5), 0 16px 40px -8px oklch(0 0 0 / 0.6)" } }, "$description": "Overlays: dialogs, popovers" }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": { "value": 50, "unit": "ms" }, "$description": "Press feedback" },
    "micro": { "$type": "duration", "$value": { "value": 100, "unit": "ms" }, "$description": "Hover, toggles" },
    "short": { "$type": "duration", "$value": { "value": 150, "unit": "ms" }, "$description": "Small reveals, exits of standard" },
    "standard": { "$type": "duration", "$value": { "value": 250, "unit": "ms" }, "$description": "Popovers, menus" },
    "medium": { "$type": "duration", "$value": { "value": 300, "unit": "ms" }, "$description": "Sheets, drawers; ceiling for routine UI" },
    "long": { "$type": "duration", "$value": { "value": 400, "unit": "ms" }, "$description": "Page transitions, rare moments" },
    "hero": { "$type": "duration", "$value": { "value": 500, "unit": "ms" }, "$description": "Signature moment only; nothing longer except backdrops" }
  },
  "easing": {
    "enter": { "$type": "cubicBezier", "$value": [0, 0, 0, 1], "$description": "Elements arriving (decelerate)" },
    "enter-emphasized": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1], "$description": "Expressive arrivals, signature moment" },
    "exit": { "$type": "cubicBezier", "$value": [0.3, 0, 1, 1], "$description": "Elements leaving (accelerate)" },
    "move": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "On-screen movement and resizing" },
    "snappy": { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1], "$description": "Direct-manipulation feedback, drawers" },
    "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1], "$description": "Progress, opacity-only loops" }
  }
}
