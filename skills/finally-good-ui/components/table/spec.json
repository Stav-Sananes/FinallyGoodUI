{
  "name": "table",
  "shapes": [
    "table"
  ],
  "props": [
    {
      "name": "columns",
      "type": "array",
      "ts": "{ key: string; label: string; sortable?: boolean; align?: \"start\" | \"end\" }[]",
      "default": "[]"
    },
    {
      "name": "rows",
      "type": "array",
      "ts": "{ id: string; [key: string]: string | number | undefined }[]",
      "default": "[]"
    },
    {
      "name": "caption",
      "type": "string"
    },
    {
      "name": "sort",
      "type": "string"
    },
    {
      "name": "selectable",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "selected",
      "type": "array",
      "ts": "string[]",
      "default": "[]"
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "sticky",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "emptyText",
      "type": "string",
      "default": "No rows"
    },
    {
      "name": "loadingText",
      "type": "string",
      "default": "Loading"
    }
  ],
  "events": [
    "sortchange",
    "selectionchange"
  ],
